# Server-side only. Never prefix these with VITE_, which would expose them in the frontend bundle.

# PVWatts key, used by api/pvwatts.js (Vercel) and netlify/functions/pvwatts.mjs (Netlify)
NREL_API_KEY=your-nrel-api-key-here

# Shared login password, checked by middleware.js on Vercel
SITE_PASSWORD=choose-a-long-password
